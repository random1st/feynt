<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unsandboxed: the app reads model weights from ~/.lmstudio and its own support
         directory, both outside a sandbox container. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- MLX compiles Metal kernels at runtime; W^X relaxation is required for the JIT. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Model downloads from Hugging Face, plus the loopback listener. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
